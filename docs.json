{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dancity",
  "colors": {
    "primary": "#074DEB",
    "light": "#4A7AFF",
    "dark": "#00144C"
  },
  "favicon": "/logo/light.svg",
  "api": {
    "openapi": "api-reference/openapi.json",
    "url": "full",
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["bash", "javascript", "python"],
      "prefill": true,
      "defaults": "all"
    }
  },
  "logo": {
    "light": "https://res.cloudinary.com/dglkxgoei/image/upload/v1774273336/Frame_42_ylgngi.png",
    "dark": "https://res.cloudinary.com/dglkxgoei/image/upload/v1774273336/Frame_42_ylgngi.png",
    "href": "https://dancity.app"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@dancity.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dancity.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index"]
          },
          {
            "group": "Integration",
            "pages": [
              "guides/authentication",
              "guides/errors",
              "guides/rate-limits",
              "guides/webhook"
            ]
          },
          {
            "group": "Wallet",
            "pages": ["guides/wallet"]
          },
          {
            "group": "Products & services",
            "pages": ["guides/catalog"]
          },
          {
            "group": "VAS",
            "pages": [
              "guides/airtime-data",
              "guides/cable-tv",
              "guides/electricity",
              "guides/internet",
              "guides/education-pins",
              "guides/betting"
            ]
          },
          {
            "group": "eSIM",
            "pages": ["guides/esim"]
          },
          {
            "group": "Transactions",
            "pages": ["guides/transactions"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Wallet",
            "pages": [
              "api-reference/wallet/get-api-wallet"
            ]
          },
          {
            "group": "Products & services",
            "pages": [
              "api-reference/catalog/get-api-service",
              "api-reference/catalog/get-api-products",
              "api-reference/catalog/get-api-plans-data",
              "api-reference/catalog/get-api-plans-cable"
            ]
          },
          {
            "group": "VAS",
            "pages": [
              "api-reference/v1/post-api-v1-data-buy",
              "api-reference/v1/post-api-v1-airtime-buy",
              "api-reference/v1/post-api-v1-cable-validate",
              "api-reference/v1/post-api-v1-electricity-validate",
              "api-reference/v1/post-api-v1-cable-buy",
              "api-reference/v1/post-api-v1-electricity-buy",
              "api-reference/v1/post-api-v1-internet-buy",
              "api-reference/education/post-api-education-pin-purchase",
              "api-reference/betting/post-api-betting-funding"
            ]
          },
          {
            "group": "eSIM",
            "pages": [
              "api-reference/esim/get-api-esim-regions",
              "api-reference/esim/get-api-esim-packages",
              "api-reference/esim/get-api-esim-topup-packages",
